{
  "name": "perch-mcp-v2",
  "version": "2.4.0",
  "description": "MCP v2 (2026-07-28 stateless) server: read/write control of a Perchance.org generator's live editor. Default engine: playwright firefox; optional chromium / patchright fallbacks.",
  "type": "commonjs",
  "main": "perch-mcp.mjs",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "perch-mcp": "perch-mcp.mjs"
  },
  "scripts": {
    "start": "node perch-mcp.mjs",
    "test:core": "node test/smoke-core.mjs",
    "test:mcp": "node test/smoke-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "playwright": "^1.64.0"
  },
  "optionalDependencies": {
    "patchright": "^1.64.1"
  }
}
